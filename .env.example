# --- Application (copier dans .env.local) -----------------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — serveur uniquement, jamais préfixé NEXT_PUBLIC_. Sert à envoyer les invitations.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique du site (liens dans les e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tests locaux (copier dans .env.test.local) ------------------------------
# Base PostgreSQL locale dédiée aux tests ; son nom DOIT finir par _test (elle est effacée à chaque lancement).
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/distribuguard_test
# Binaire PostgREST (https://github.com/PostgREST/postgrest/releases) pour les tests « via l'API ».
# POSTGREST_BIN=/chemin/vers/postgrest
